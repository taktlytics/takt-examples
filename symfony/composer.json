{
  "name": "vskstudio/takt-example-symfony",
  "description": "Minimal Symfony Takt example: {{ takt() }} Twig function + autowired Takt service for server-side events.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "symfony/framework-bundle": "^6.4 || ^7.0",
    "symfony/http-client": "^6.4 || ^7.0",
    "symfony/twig-bundle": "^6.4 || ^7.0",
    "vskstudio/takt-symfony": "^0.7.0"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.3.99"
    }
  },
  "scripts": { "build": "@php verify.php" },
  "minimum-stability": "stable"
}
